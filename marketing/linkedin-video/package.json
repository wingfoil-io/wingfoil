{
  "name": "wingfoil-linkedin-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion composition for the wingfoil LinkedIn marketing video",
  "scripts": {
    "start": "remotion studio",
    "capture": "scripts/capture-output.sh",
    "voice": "python3 scripts/build-voice.py",
    "srt": "python3 scripts/build-srt.py",
    "render": "remotion render WingfoilLinkedIn out/wingfoil_linkedin.mp4",
    "typecheck": "tsc --noEmit",
    "build": "npm run capture && npm run voice && npm run srt && npm run render"
  },
  "dependencies": {
    "@remotion/cli": "4.0.407",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.407"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.3"
  }
}
