# Grafana with the trading_e2e datasources + dashboard baked in.
#
# Build from the repo root:
#   docker build -f crates/wingfoil/examples/showcase/trading_e2e/Dockerfile.grafana \
#     -t wingfoil-grafana:latest .
FROM grafana/grafana:11.3.0

COPY crates/wingfoil/examples/showcase/trading_e2e/grafana/provisioning /etc/grafana/provisioning
