# Tempo with the latency_e2e config baked in.
#
# Build from the repo root:
#   docker build -f crates/wingfoil-next/examples/latency_e2e/Dockerfile.tempo \
#     -t wingfoil-tempo:latest .
FROM grafana/tempo:2.6.1

COPY crates/wingfoil-next/examples/latency_e2e/tempo/tempo.yaml /etc/tempo/tempo.yaml
